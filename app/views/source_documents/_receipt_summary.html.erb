<% receipt = local_assigns.fetch(:receipt) { source_document.receipts.order(created_at: :desc).first } %>

<section id="<%= dom_id(source_document, :receipt_summary) %>" class="rounded border border-slate-200 bg-white p-5 text-sm shadow-sm">
  <h2 class="text-lg font-semibold text-slate-950"><%= t("source_documents.show.receipt.heading") %></h2>
  <% if receipt %>
    <p class="mt-3 text-slate-600"><%= t("source_documents.show.receipt.present") %></p>
    <%= link_to t("source_documents.show.receipt.link"),
                receipts_path(anchor: dom_id(receipt)),
                class: "mt-4 inline-flex rounded bg-slate-950 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800" %>
    <%= link_to t("source_documents.show.receipt.review_link"),
                edit_receipt_path(receipt),
                class: "mt-4 inline-flex rounded border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
  <% else %>
    <p class="mt-3 text-slate-600"><%= t("source_documents.show.receipt.empty") %></p>
  <% end %>
</section>
