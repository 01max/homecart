<% receipt = local_assigns.fetch(:receipt) { source_document.receipts.order(created_at: :desc).first } %>

<section id="<%= dom_id(source_document, :receipt_summary) %>" class="hc-detail-block hc-block text-sm">
  <div class="hc-block-heading">
    <h2 class="hc-block-title"><%= t("source_documents.show.receipt.heading") %></h2>
    <p class="hc-block-description"><%= t("source_documents.show.receipt.description") %></p>
  </div>
  <% if receipt %>
    <p class="hc-body mt-3 text-sm"><%= t("source_documents.show.receipt.present") %></p>
    <div class="hc-action-group mt-4">
      <%= link_to t("source_documents.show.receipt.link"),
                  receipt_path(receipt),
                  class: "hc-button hc-button--primary" %>
      <%= link_to t("source_documents.show.receipt.review_link"),
                  edit_receipt_path(receipt),
                  class: "hc-button hc-button--secondary" %>
    </div>
  <% else %>
    <p class="hc-body mt-3 text-sm"><%= t("source_documents.show.receipt.empty") %></p>
  <% end %>
</section>
