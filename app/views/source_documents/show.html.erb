<% content_for :title, t(".title") %>
<%= turbo_stream_from @source_document %>

<section>
  <div class="mb-6">
    <p class="text-sm font-medium text-slate-500"><%= t(".eyebrow") %></p>
    <h1 class="mt-2 text-3xl font-semibold tracking-normal text-slate-950"><%= t(".title") %></h1>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,24rem)]">
    <div class="space-y-6">
      <section class="rounded border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-950"><%= t(".preview.heading") %></h2>

        <% if @source_document.original_file.attached? %>
          <div class="mt-4 overflow-hidden rounded border border-slate-200 bg-slate-50">
            <% if @source_document.mime_type_png? || @source_document.mime_type_jpeg? %>
              <%= image_tag @source_document.original_file, alt: t(".preview.image_alt"), class: "max-h-[42rem] w-full object-contain" %>
            <% elsif @source_document.mime_type_pdf? %>
              <iframe src="<%= url_for(@source_document.original_file) %>" title="<%= t(".preview.pdf_title") %>" class="h-[42rem] w-full"></iframe>
            <% else %>
              <div class="p-4 text-sm text-slate-600"><%= t(".preview.unavailable") %></div>
            <% end %>
          </div>
          <div class="mt-3">
            <%= link_to t(".preview.open_original"), @source_document.original_file, class: "text-sm font-medium text-slate-700 underline underline-offset-4" %>
          </div>
        <% else %>
          <p class="mt-3 text-sm text-slate-600"><%= t(".preview.missing_file") %></p>
        <% end %>
      </section>

      <%= render "source_documents/latest_extraction",
                 source_document: @source_document,
                 latest_text_extraction: @latest_text_extraction %>
    </div>

    <aside class="space-y-6">
      <%= render "source_documents/processing_status",
                 source_document: @source_document,
                 latest_text_extraction: @latest_text_extraction,
                 receipt: @receipt %>

      <section class="rounded border border-slate-200 bg-white p-5 text-sm shadow-sm">
        <h2 class="text-lg font-semibold text-slate-950"><%= t(".details.heading") %></h2>
        <dl class="mt-4 space-y-4">
          <div>
            <dt class="font-medium text-slate-500"><%= t(".details.store") %></dt>
            <dd class="mt-1 text-slate-950"><%= store_option_label(@source_document.store) %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-500"><%= t(".details.parser_format") %></dt>
            <dd class="mt-1 font-mono text-slate-950"><%= @source_document.parser_format_before_type_cast %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-500"><%= t(".details.mime_type") %></dt>
            <dd class="mt-1 text-slate-950"><%= @source_document.mime_type_before_type_cast %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-500"><%= t(".details.ingested_at") %></dt>
            <dd class="mt-1 text-slate-950"><%= l(@source_document.ingested_at, format: :short) %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-500"><%= t(".details.content_hash") %></dt>
            <dd class="mt-1 break-all font-mono text-xs text-slate-950"><%= @source_document.content_hash %></dd>
          </div>
        </dl>
      </section>

      <%= render "source_documents/receipt_summary",
                 source_document: @source_document,
                 receipt: @receipt %>
    </aside>
  </div>
</section>
