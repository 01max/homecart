<% content_for :title, t(".title") %>
<%= turbo_stream_from @source_document %>

<section class="hc-stack"
         data-controller="source-document-processing"
         data-source-document-processing-url-value="<%= status_source_document_path(@source_document, format: :turbo_stream) %>">
  <div class="hc-page-toolbar">
    <div>
      <p class="hc-eyebrow"><%= t(".eyebrow") %></p>
      <h1 class="hc-heading-lg mt-2"><%= t(".title") %></h1>
      <p class="hc-body mt-2"><%= t(".description") %></p>
    </div>

    <div class="hc-page-actions">
      <%= link_to t(".actions.upload_receipt"), new_source_document_path, class: "hc-button hc-button--primary" %>
      <%= link_to t(".actions.view_receipts"), receipts_path, class: "hc-button hc-button--secondary" %>
      <% if @receipt %>
        <%= link_to t(".actions.review_receipt"), edit_receipt_path(@receipt), class: "hc-button hc-button--subtle" %>
      <% end %>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,24rem)]">
    <div class="space-y-6">
      <section class="hc-evidence-block hc-block">
        <div class="hc-block-heading">
          <h2 class="hc-block-title"><%= t(".preview.heading") %></h2>
          <p class="hc-block-description"><%= t(".preview.description") %></p>
        </div>

        <% if @source_document.original_file.attached? %>
          <div class="hc-surface-muted mt-4 overflow-hidden">
            <% if @source_document.mime_type_png? || @source_document.mime_type_jpeg? %>
              <%= image_tag @source_document.original_file, alt: t(".preview.image_alt"), class: "max-h-[42rem] w-full object-contain" %>
            <% elsif @source_document.mime_type_pdf? %>
              <iframe src="<%= url_for(@source_document.original_file) %>" title="<%= t(".preview.pdf_title") %>" class="h-[42rem] w-full"></iframe>
            <% else %>
              <div class="hc-body p-4 text-sm"><%= t(".preview.unavailable") %></div>
            <% end %>
          </div>
          <div class="mt-3">
            <%= link_to t(".preview.open_original"), @source_document.original_file, class: "hc-link text-sm" %>
          </div>
        <% else %>
          <p class="hc-body mt-3 text-sm"><%= t(".preview.missing_file") %></p>
        <% end %>
      </section>

      <%= render "source_documents/latest_extraction",
                 source_document: @source_document,
                 latest_text_extraction: @latest_text_extraction %>
    </div>

    <aside class="space-y-6">
      <%= render "source_documents/processing_status",
                 source_document: @source_document,
                 latest_text_extraction: @latest_text_extraction,
                 receipt: @receipt %>

      <section class="hc-detail-block hc-block text-sm">
        <div class="hc-block-heading">
          <h2 class="hc-block-title"><%= t(".details.heading") %></h2>
          <p class="hc-block-description"><%= t(".details.description") %></p>
        </div>
        <dl class="hc-detail-grid mt-4">
          <div class="hc-detail-item">
            <dt class="hc-detail-term"><%= t(".details.store") %></dt>
            <dd class="hc-detail-value"><%= store_option_label(@source_document.store) %></dd>
          </div>
          <div class="hc-detail-item">
            <dt class="hc-detail-term"><%= t(".details.parser_format") %></dt>
            <dd class="hc-detail-value hc-code"><%= @source_document.parser_format_before_type_cast %></dd>
          </div>
          <div class="hc-detail-item">
            <dt class="hc-detail-term"><%= t(".details.mime_type") %></dt>
            <dd class="hc-detail-value"><%= @source_document.mime_type_before_type_cast %></dd>
          </div>
          <div class="hc-detail-item">
            <dt class="hc-detail-term"><%= t(".details.ingested_at") %></dt>
            <dd class="hc-detail-value"><%= l(@source_document.ingested_at, format: :short) %></dd>
          </div>
          <div class="hc-detail-item sm:col-span-2">
            <dt class="hc-detail-term"><%= t(".details.content_hash") %></dt>
            <dd class="hc-detail-value hc-code"><%= @source_document.content_hash %></dd>
          </div>
        </dl>
      </section>

      <%= render "source_documents/receipt_summary",
                 source_document: @source_document,
                 receipt: @receipt %>
    </aside>
  </div>
</section>
