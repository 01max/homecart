<% content_for :title, t(".title") %>

<section class="max-w-2xl">
  <div class="mb-6">
    <p class="text-sm font-medium text-slate-500"><%= t(".eyebrow") %></p>
    <h1 class="mt-2 text-3xl font-semibold tracking-normal text-slate-950"><%= t(".title") %></h1>
  </div>

  <dl class="rounded border border-slate-200 bg-white p-5 text-sm shadow-sm">
    <div>
      <dt class="font-medium text-slate-500"><%= t(".content_hash") %></dt>
      <dd class="mt-1 break-all font-mono text-slate-950"><%= @source_document.content_hash %></dd>
    </div>
  </dl>
</section>
