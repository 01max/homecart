<% latest_source_document_detection = local_assigns[:latest_source_document_detection] || source_document.source_document_detections.includes(:store).order(created_at: :desc, id: :desc).first %>
<% current_store_label = source_document.store ? store_option_label(source_document.store) : t("source_documents.show.classification.empty") %>
<% current_parser_format = source_document.parser_format_before_type_cast.presence || t("source_documents.show.classification.empty") %>
<% detection_evidence = Array(latest_source_document_detection&.evidence) %>
<% classification_stores = local_assigns.fetch(:classification_stores) { source_document_classification_stores } %>
<% parser_formats = local_assigns.fetch(:parser_formats) { source_document_parser_format_options } %>

<section id="<%= dom_id(source_document, :classification_panel) %>" class="hc-detail-block hc-block text-sm">
  <div class="hc-block-heading">
    <h2 class="hc-block-title"><%= t("source_documents.show.classification.heading") %></h2>
    <p class="hc-block-description"><%= t("source_documents.show.classification.description") %></p>
  </div>

  <dl class="hc-detail-grid mt-4">
    <div class="hc-detail-item">
      <dt class="hc-detail-term"><%= t("source_documents.show.classification.current_status") %></dt>
      <dd class="hc-detail-value">
        <span class="hc-badge hc-badge--<%= source_document.classified? ? "complete" : "neutral" %>">
          <%= t("source_documents.show.classification.statuses.#{source_document.source_detection_status}") %>
        </span>
      </dd>
    </div>
    <div class="hc-detail-item">
      <dt class="hc-detail-term"><%= t("source_documents.show.classification.current_store") %></dt>
      <dd class="hc-detail-value"><%= current_store_label %></dd>
    </div>
    <div class="hc-detail-item">
      <dt class="hc-detail-term"><%= t("source_documents.show.classification.current_parser_format") %></dt>
      <dd class="hc-detail-value hc-code"><%= current_parser_format %></dd>
    </div>
  </dl>

  <% if latest_source_document_detection %>
    <div class="hc-divider-top mt-4 pt-3">
      <h3 class="hc-detail-term"><%= t("source_documents.show.classification.latest_detection") %></h3>
      <dl class="hc-detail-grid mt-3">
        <div class="hc-detail-item">
          <dt class="hc-detail-term"><%= t("source_documents.show.classification.detection_status") %></dt>
          <dd class="hc-detail-value"><%= t("source_documents.show.classification.statuses.#{latest_source_document_detection.status}") %></dd>
        </div>
        <div class="hc-detail-item">
          <dt class="hc-detail-term"><%= t("source_documents.show.classification.parser_confidence") %></dt>
          <dd class="hc-detail-value"><%= t("source_documents.show.classification.confidences.#{latest_source_document_detection.parser_confidence}") %></dd>
        </div>
        <div class="hc-detail-item">
          <dt class="hc-detail-term"><%= t("source_documents.show.classification.store_confidence") %></dt>
          <dd class="hc-detail-value"><%= t("source_documents.show.classification.confidences.#{latest_source_document_detection.store_confidence}") %></dd>
        </div>
        <div class="hc-detail-item">
          <dt class="hc-detail-term"><%= t("source_documents.show.classification.detected_at") %></dt>
          <dd class="hc-detail-value"><%= l(latest_source_document_detection.created_at, format: :short) %></dd>
        </div>
      </dl>

      <h3 class="hc-detail-term mt-4"><%= t("source_documents.show.classification.evidence") %></h3>
      <% if detection_evidence.any? %>
        <ul class="mt-2 grid gap-2">
          <% detection_evidence.each do |entry| %>
            <li class="hc-surface-muted p-3">
              <p class="font-semibold"><%= source_document_detection_evidence_label(entry) %></p>
              <% evidence_details = source_document_detection_evidence_details(entry) %>
              <% if evidence_details.any? %>
                <dl class="mt-2 grid gap-1">
                  <% evidence_details.each do |label, value| %>
                    <div class="grid gap-1 sm:grid-cols-[8rem_minmax(0,1fr)]">
                      <dt class="hc-detail-term"><%= label %></dt>
                      <dd class="hc-detail-value break-words"><%= value %></dd>
                    </div>
                  <% end %>
                </dl>
              <% end %>
            </li>
          <% end %>
        </ul>
        <details class="mt-3">
          <summary class="hc-link cursor-pointer"><%= t("source_documents.show.classification.evidence_raw") %></summary>
          <pre class="hc-evidence-pane mt-2 max-h-96"><%= JSON.pretty_generate(detection_evidence) %></pre>
        </details>
      <% else %>
        <p class="hc-body mt-2 text-sm"><%= t("source_documents.show.classification.evidence_empty") %></p>
      <% end %>
    </div>
  <% else %>
    <p class="hc-body mt-4 text-sm"><%= t("source_documents.show.classification.no_detection") %></p>
  <% end %>

  <% if source_document.needs_classification? %>
    <div class="hc-divider-top mt-4 pt-3">
      <h3 class="hc-detail-term"><%= t("source_documents.show.classification.manual.heading") %></h3>
      <p class="hc-body mt-2 text-sm"><%= t("source_documents.show.classification.manual.description") %></p>

      <%= form_with url: classify_source_document_path(source_document),
                    scope: :source_document,
                    method: :patch,
                    local: true,
                    class: "mt-3 grid gap-3" do |form| %>
        <div class="hc-filter-group">
          <%= form.label :store_id, t("source_documents.show.classification.manual.store_label"), class: "hc-label" %>
          <%= form.select :store_id,
                          source_document_classification_store_options(classification_stores),
                          { prompt: t("source_documents.show.classification.manual.store_prompt"), selected: source_document.store_id },
                          class: "hc-select block" %>
        </div>

        <div class="hc-filter-group">
          <%= form.label :parser_format, t("source_documents.show.classification.manual.parser_format_label"), class: "hc-label" %>
          <%= form.select :parser_format,
                          parser_formats,
                          { prompt: t("source_documents.show.classification.manual.parser_format_prompt"), selected: source_document.parser_format_before_type_cast },
                          class: "hc-select block" %>
        </div>

        <div class="hc-filter-actions">
          <%= form.submit t("source_documents.show.classification.manual.submit"), class: "hc-button hc-button--primary" %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
