<% content_for :title, t(".title") %>

<section class="max-w-2xl">
  <div class="hc-page-header">
    <p class="hc-eyebrow"><%= t(".eyebrow") %></p>
    <h1 class="hc-heading-lg mt-2"><%= t(".title") %></h1>
  </div>

  <%= form_with url: source_documents_path,
                scope: :source_document,
                local: true,
                html: { multipart: true, data: { controller: "parser-format-suggestion" } },
                class: "hc-card space-y-5" do |form| %>
    <div>
      <%= form.label :file, t(".file_label"), class: "hc-label" %>
      <%= form.file_field :file, accept: @accepted_mime_types, class: "hc-file-input mt-2 block" %>
    </div>

    <div>
      <%= form.label :store_id, t(".store_label"), class: "hc-label" %>
      <%= form.select :store_id,
                      store_options_for_select,
                      { prompt: t(".store_prompt"), selected: @selected_store_id },
                      class: "hc-select mt-2 block",
                      data: {
                        parser_format_suggestion_target: "store",
                        action: "parser-format-suggestion#suggest"
                      } %>
    </div>

    <div>
      <%= form.label :parser_format, t(".parser_format_label"), class: "hc-label" %>
      <%= form.select :parser_format,
                      @parser_formats,
                      { prompt: t(".parser_format_prompt"), selected: @selected_parser_format },
                      class: "hc-select mt-2 block",
                      data: {
                        parser_format_suggestion_target: "parserFormat",
                        action: "parser-format-suggestion#markManualSelection"
                      } %>
    </div>

    <div class="pt-2">
      <%= form.submit t(".submit"), class: "hc-button hc-button--primary" %>
    </div>
  <% end %>
</section>
