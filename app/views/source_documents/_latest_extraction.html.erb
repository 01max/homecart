<% latest_text_extraction = local_assigns.fetch(:latest_text_extraction) { source_document.text_extractions.order(ran_at: :desc, created_at: :desc).first } %>

<section id="<%= dom_id(source_document, :latest_text_extraction) %>" class="hc-evidence-block hc-block">
  <div class="hc-block-heading">
    <h2 class="hc-block-title"><%= t("source_documents.show.latest_extraction.heading") %></h2>
    <p class="hc-block-description"><%= t("source_documents.show.latest_extraction.description") %></p>
  </div>

  <% if latest_text_extraction %>
    <dl class="hc-detail-grid mt-4 text-sm sm:grid-cols-3">
      <div class="hc-detail-item">
        <dt class="hc-detail-term"><%= t("source_documents.show.latest_extraction.engine") %></dt>
        <dd class="hc-detail-value hc-code"><%= latest_text_extraction.engine %></dd>
      </div>
      <div class="hc-detail-item">
        <dt class="hc-detail-term"><%= t("source_documents.show.latest_extraction.ran_at") %></dt>
        <dd class="hc-detail-value"><%= l(latest_text_extraction.ran_at, format: :short) %></dd>
      </div>
      <div class="hc-detail-item">
        <dt class="hc-detail-term"><%= t("source_documents.show.latest_extraction.status") %></dt>
        <dd class="hc-detail-value">
          <span class="hc-badge <%= latest_text_extraction.success? ? "hc-badge--success" : "hc-badge--failed" %>">
          <%= latest_text_extraction.success? ? t("source_documents.show.latest_extraction.success") : t("source_documents.show.latest_extraction.failure") %>
          </span>
        </dd>
      </div>
    </dl>

    <% if latest_text_extraction.success? %>
      <pre class="hc-evidence-pane mt-4 max-h-[28rem]"><%= latest_text_extraction.text %></pre>
    <% else %>
      <p class="hc-flash hc-flash--alert mt-4 text-sm"><%= latest_text_extraction.error_message %></p>
    <% end %>
  <% else %>
    <p class="hc-body mt-3 text-sm"><%= t("source_documents.show.latest_extraction.empty") %></p>
  <% end %>
</section>
