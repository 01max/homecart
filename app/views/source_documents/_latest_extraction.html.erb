<% latest_text_extraction = local_assigns.fetch(:latest_text_extraction) { source_document.text_extractions.order(ran_at: :desc, created_at: :desc).first } %>

<section id="<%= dom_id(source_document, :latest_text_extraction) %>" class="rounded border border-slate-200 bg-white p-5 shadow-sm">
  <h2 class="text-lg font-semibold text-slate-950"><%= t("source_documents.show.latest_extraction.heading") %></h2>

  <% if latest_text_extraction %>
    <dl class="mt-4 grid gap-4 text-sm sm:grid-cols-3">
      <div>
        <dt class="font-medium text-slate-500"><%= t("source_documents.show.latest_extraction.engine") %></dt>
        <dd class="mt-1 text-slate-950"><%= latest_text_extraction.engine %></dd>
      </div>
      <div>
        <dt class="font-medium text-slate-500"><%= t("source_documents.show.latest_extraction.ran_at") %></dt>
        <dd class="mt-1 text-slate-950"><%= l(latest_text_extraction.ran_at, format: :short) %></dd>
      </div>
      <div>
        <dt class="font-medium text-slate-500"><%= t("source_documents.show.latest_extraction.status") %></dt>
        <dd class="mt-1 text-slate-950">
          <%= latest_text_extraction.success? ? t("source_documents.show.latest_extraction.success") : t("source_documents.show.latest_extraction.failure") %>
        </dd>
      </div>
    </dl>

    <% if latest_text_extraction.success? %>
      <pre class="mt-4 max-h-[28rem] overflow-auto rounded bg-slate-950 p-4 text-sm leading-6 text-slate-50"><%= latest_text_extraction.text %></pre>
    <% else %>
      <p class="mt-4 rounded bg-rose-50 p-4 text-sm text-rose-900"><%= latest_text_extraction.error_message %></p>
    <% end %>
  <% else %>
    <p class="mt-3 text-sm text-slate-600"><%= t("source_documents.show.latest_extraction.empty") %></p>
  <% end %>
</section>
