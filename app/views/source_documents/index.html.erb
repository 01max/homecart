<% content_for :title, t(".title") %>

<section class="hc-stack">
  <div class="hc-page-toolbar">
    <div>
      <p class="hc-eyebrow"><%= t(".eyebrow") %></p>
      <h1 class="hc-heading-lg mt-2"><%= t(".title") %></h1>
      <p class="hc-body mt-2"><%= t(".description") %></p>
    </div>

    <div class="hc-page-actions">
      <%= link_to t(".actions.upload_receipt"), new_source_document_path, class: "hc-button hc-button--primary" %>
      <%= link_to t(".actions.view_receipts"), receipts_path, class: "hc-button hc-button--secondary" %>
    </div>
  </div>

  <div class="hc-table-block">
    <div class="hc-block-header">
      <div class="hc-block-heading">
        <h2 class="hc-block-title"><%= t(".workbench.heading") %></h2>
        <p class="hc-block-description"><%= t(".workbench.description") %></p>
      </div>
      <p class="hc-badge hc-badge--neutral"><%= t(".workbench.count", count: @source_documents.size) %></p>
    </div>

    <% if @source_documents.any? %>
      <div class="hc-table-frame">
        <table class="hc-table hc-table--dense min-w-[72rem]">
          <thead>
            <tr>
              <th><%= t(".table.ingested_at") %></th>
              <th><%= t(".table.store") %></th>
              <th><%= t(".table.parser_format") %></th>
              <th><%= t(".table.mime_type") %></th>
              <th><%= t(".table.extraction") %></th>
              <th><%= t(".table.receipt") %></th>
              <th><%= t(".table.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @source_documents.each do |source_document| %>
              <% latest_extraction = source_document.text_extractions.max_by { |extraction| [ extraction.ran_at || Time.zone.at(0), extraction.created_at ] } %>
              <% receipt = source_document.receipts.max_by(&:created_at) %>
              <tr id="<%= dom_id(source_document) %>">
                <td class="whitespace-nowrap"><%= l(source_document.ingested_at, format: :short) %></td>
                <td><%= store_option_label(source_document.store) %></td>
                <td class="hc-code whitespace-nowrap"><%= source_document.parser_format_before_type_cast %></td>
                <td class="whitespace-nowrap"><%= source_document.mime_type_before_type_cast %></td>
                <td class="whitespace-nowrap">
                  <% if latest_extraction %>
                    <span class="hc-badge <%= latest_extraction.success? ? "hc-badge--success" : "hc-badge--failed" %>">
                      <%= latest_extraction.success? ? t(".extraction.success") : t(".extraction.failure") %>
                    </span>
                  <% else %>
                    <span class="hc-badge hc-badge--neutral"><%= t(".extraction.waiting") %></span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap">
                  <% if receipt %>
                    <span class="hc-badge <%= receipt.needs_review? ? "hc-badge--warning" : "hc-badge--success" %>">
                      <%= parser_status_label(receipt.parser_status) %>
                    </span>
                  <% else %>
                    <span class="hc-badge hc-badge--neutral"><%= t(".receipt.empty") %></span>
                  <% end %>
                </td>
                <td>
                  <div class="hc-table-cell-actions">
                    <%= link_to t(".actions.view_source"),
                                source_document_path(source_document),
                                class: "hc-link text-sm" %>
                    <% if receipt %>
                      <%= link_to t(".actions.view_receipt"),
                                  receipt_path(receipt),
                                  class: "hc-link text-sm" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="hc-block-body">
        <p class="hc-body text-sm"><%= t(".empty") %></p>
      </div>
    <% end %>
  </div>
</section>
