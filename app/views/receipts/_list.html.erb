<% current_sort_column = local_assigns.fetch(:sort_column, "purchased_at") %>
<% current_sort_direction = local_assigns.fetch(:sort_direction, "desc") %>
<% sort_link_params = lambda do |column|
     next_direction = current_sort_column == column && current_sort_direction == "asc" ? "desc" : "asc"
     { parser_status: selected_parser_status, sort: column, direction: next_direction }.compact
   end %>
<% sort_indicator = lambda do |column|
     next "" unless current_sort_column == column

     current_sort_direction == "asc" ? "↑" : "↓"
   end %>
<% sort_label = lambda do |column, label|
     next_direction = current_sort_column == column && current_sort_direction == "asc" ? "desc" : "asc"
     t(
       "receipts.index.sort.label",
       column: label,
       direction: t("receipts.index.sort.directions.#{next_direction}")
     )
   end %>

<div id="<%= ReceiptIngestion::BroadcastProcessingStatusService.receipts_list_dom_id(selected_parser_status) %>">
  <div class="hc-table-block">
    <div class="hc-block-header">
      <div class="hc-block-heading">
        <h2 class="hc-block-title"><%= t("receipts.index.workbench.heading") %></h2>
        <p class="hc-block-description">
          <% if selected_parser_status %>
            <%= t("receipts.index.workbench.filtered_description", status: parser_status_label(selected_parser_status)) %>
          <% else %>
            <%= t("receipts.index.workbench.description") %>
          <% end %>
        </p>
      </div>
      <p class="hc-badge hc-badge--neutral"><%= t("receipts.index.workbench.count", count: receipts.size) %></p>
    </div>

    <% if receipts.any? %>
      <div class="hc-table-frame">
        <table class="hc-table hc-table--dense min-w-[72rem]">
          <thead>
            <tr>
              <th>
                <%= link_to receipts_path(sort_link_params.call("purchased_at")),
                            class: "hc-link whitespace-nowrap",
                            aria: { label: sort_label.call("purchased_at", t("receipts.index.table.purchased_at")) } do %>
                  <%= t("receipts.index.table.purchased_at") %>
                  <span aria-hidden="true"><%= sort_indicator.call("purchased_at") %></span>
                <% end %>
              </th>
              <th>
                <%= link_to receipts_path(sort_link_params.call("store")),
                            class: "hc-link whitespace-nowrap",
                            aria: { label: sort_label.call("store", t("receipts.index.table.store")) } do %>
                  <%= t("receipts.index.table.store") %>
                  <span aria-hidden="true"><%= sort_indicator.call("store") %></span>
                <% end %>
              </th>
              <th>
                <%= link_to receipts_path(sort_link_params.call("parser_status")),
                            class: "hc-link whitespace-nowrap",
                            aria: { label: sort_label.call("parser_status", t("receipts.index.table.parser_status")) } do %>
                  <%= t("receipts.index.table.parser_status") %>
                  <span aria-hidden="true"><%= sort_indicator.call("parser_status") %></span>
                <% end %>
              </th>
              <th>
                <%= link_to receipts_path(sort_link_params.call("total")),
                            class: "hc-link whitespace-nowrap",
                            aria: { label: sort_label.call("total", t("receipts.index.table.total")) } do %>
                  <%= t("receipts.index.table.total") %>
                  <span aria-hidden="true"><%= sort_indicator.call("total") %></span>
                <% end %>
              </th>
              <th>
                <%= link_to receipts_path(sort_link_params.call("parser_format")),
                            class: "hc-link whitespace-nowrap",
                            aria: { label: sort_label.call("parser_format", t("receipts.index.table.parser_format")) } do %>
                  <%= t("receipts.index.table.parser_format") %>
                  <span aria-hidden="true"><%= sort_indicator.call("parser_format") %></span>
                <% end %>
              </th>
              <th><%= t("receipts.index.table.source_document") %></th>
              <th><%= t("receipts.index.table.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <%= render partial: "receipts/receipt", collection: receipts, as: :receipt %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="hc-block-body">
        <p class="hc-body text-sm"><%= t("receipts.index.empty") %></p>
      </div>
    <% end %>
  </div>
</div>
