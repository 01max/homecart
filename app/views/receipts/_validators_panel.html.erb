<section class="hc-card">
  <h3 class="hc-heading-md"><%= t("receipts.edit.validators.heading") %></h3>

  <div class="mt-4 grid gap-3 md:grid-cols-3">
    <% %w[totals_sum article_count payments_sum].each do |validator| %>
      <div class="hc-validator-card"
           data-receipt-validators-target="<%= "#{validator.camelize(:lower)}Card" %>">
        <div class="flex items-center justify-between gap-3">
          <p class="hc-label"><%= t("receipts.edit.validators.#{validator}.label") %></p>
          <span class="hc-badge hc-badge--neutral"
                data-receipt-validators-target="<%= "#{validator.camelize(:lower)}Status" %>">
            <%= t("receipts.edit.validators.pending") %>
          </span>
        </div>
        <p class="hc-validator-detail"
           data-receipt-validators-target="<%= "#{validator.camelize(:lower)}Detail" %>">
          <%= t("receipts.edit.validators.pending_detail") %>
        </p>
      </div>
    <% end %>
  </div>
</section>
