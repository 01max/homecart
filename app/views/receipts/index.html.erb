<% content_for :title, t(".title") %>
<%= turbo_stream_from receipts_stream_name(@selected_parser_status) %>

<section class="hc-stack">
  <div class="hc-page-toolbar">
    <div>
      <p class="hc-eyebrow"><%= t(".eyebrow") %></p>
      <h1 class="hc-heading-lg mt-2"><%= t(".title") %></h1>
      <p class="hc-body mt-2"><%= t(".description") %></p>
    </div>

    <div class="hc-page-actions">
      <%= link_to t(".actions.upload_receipt"), new_source_document_path, class: "hc-button hc-button--primary" %>
      <%= link_to t(".actions.view_source_documents"), source_documents_path, class: "hc-button hc-button--secondary" %>
    </div>
  </div>

  <%= form_with url: receipts_path, method: :get, local: true, class: "hc-filter-block" do |form| %>
    <div class="hc-block-heading">
      <h2 class="hc-block-title"><%= t(".filters.heading") %></h2>
      <p class="hc-block-description"><%= t(".filters.description") %></p>
    </div>

    <div class="hc-filter-row">
      <div class="hc-filter-group">
        <%= form.label :parser_status, t(".parser_status_filter"), class: "hc-label" %>
        <%= form.select :parser_status,
                        @parser_statuses.map { |status| [ parser_status_label(status), status ] },
                        { include_blank: t(".all_statuses"), selected: @selected_parser_status },
                        class: "hc-select",
                        onchange: "this.form.requestSubmit()" %>
      </div>

      <div class="hc-filter-actions">
        <%= form.submit t(".filters.apply"), class: "hc-button hc-button--secondary" %>
        <% if @selected_parser_status %>
          <%= link_to t(".filters.clear"), receipts_path, class: "hc-button hc-button--subtle" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= render "receipts/list", receipts: @receipts, selected_parser_status: @selected_parser_status %>
</section>
