<tr id="<%= dom_id(receipt) %>">
  <td class="whitespace-nowrap">
    <%= receipt.purchased_at ? l(receipt.purchased_at, format: :receipt_index) : t("receipts.index.empty_value") %>
  </td>
  <td>
    <%= t(
          "receipts.store_label",
          brand: receipt.store.retail_brand.name,
          location: receipt.store.location_name,
          channel: receipt.store.channel
        ) %>
  </td>
  <td class="whitespace-nowrap">
    <span class="hc-badge <%= parser_status_badge_class(receipt.parser_status) %>">
      <%= t("receipts.parser_statuses.#{receipt.parser_status}") %>
    </span>
  </td>
  <td class="whitespace-nowrap">
    <%= receipt.total_cents ? number_to_currency(receipt.total_cents / 100.0, unit: "€", separator: ",", delimiter: " ", format: "%n %u") : t("receipts.index.empty_value") %>
  </td>
  <td class="hc-code whitespace-nowrap"><%= receipt.parser_format_before_type_cast %></td>
  <td>
    <div class="hc-table-cell-actions">
      <%= link_to t("receipts.index.source_document"),
                  source_document_path(receipt.source_document),
                  class: "hc-link text-sm" %>
    </div>
  </td>
  <td>
    <div class="hc-table-cell-actions">
      <%= link_to t("receipts.index.view"),
                  receipt_path(receipt),
                  class: "hc-link text-sm" %>
      <%= link_to t("receipts.index.review"),
                  edit_receipt_path(receipt),
                  class: "hc-link text-sm" %>
      <%= button_to t("receipts.index.delete"),
                    receipt_path(receipt),
                    method: :delete,
                    form: { class: "inline", data: { turbo_confirm: t("receipts.index.delete_confirm") } },
                    class: "hc-link text-sm" %>
    </div>
  </td>
</tr>
