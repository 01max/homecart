<section class="border-t border-slate-200 pt-5">
  <div class="mb-3 flex flex-col gap-1">
    <h3 class="text-base font-semibold text-slate-950"><%= t("receipts.edit.lines.heading") %></h3>
    <p class="text-sm text-slate-600"><%= t("receipts.edit.lines.add_hint") %></p>
  </div>

  <div class="overflow-x-auto rounded border border-slate-200">
    <table class="w-full min-w-[64rem] table-fixed border-collapse text-sm">
      <thead class="bg-slate-100 text-left text-xs font-semibold uppercase text-slate-600">
        <tr>
          <th class="w-16 px-2 py-2"><%= t("receipts.edit.lines.position") %></th>
          <th class="w-44 px-2 py-2"><%= t("receipts.edit.lines.label") %></th>
          <th class="w-44 px-2 py-2"><%= t("receipts.edit.lines.raw_text") %></th>
          <th class="w-24 px-2 py-2"><%= t("receipts.edit.lines.quantity") %></th>
          <th class="w-28 px-2 py-2"><%= t("receipts.edit.lines.unit_of_measure") %></th>
          <th class="w-28 px-2 py-2"><%= t("receipts.edit.lines.unit_price_cents") %></th>
          <th class="w-28 px-2 py-2"><%= t("receipts.edit.lines.total_cents") %></th>
          <th class="w-28 px-2 py-2"><%= t("receipts.edit.lines.kind") %></th>
          <th class="w-20 px-2 py-2"><%= t("receipts.edit.lines.tr_eligible") %></th>
          <th class="w-36 px-2 py-2"><%= t("receipts.edit.lines.section_label") %></th>
          <th class="w-24 px-2 py-2"><%= t("receipts.edit.lines.remove") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 bg-white">
        <%= form.fields_for :receipt_lines, receipt.receipt_lines.sort_by { |line| [ line.position || Float::INFINITY, line.id || "" ] }, include_id: false do |line_form| %>
          <tr class="<%= line_form.object.new_record? ? "bg-slate-50" : "" %>">
            <td class="px-2 py-2 align-top">
              <%= line_form.hidden_field :id if line_form.object.persisted? %>
              <%= line_form.label :position, t("receipts.edit.lines.position"), class: "sr-only" %>
              <%= line_form.number_field :position, class: "w-full rounded border border-slate-300 px-2 py-1 text-sm" %>
            </td>
            <td class="px-2 py-2 align-top">
              <%= line_form.label :label, t("receipts.edit.lines.label"), class: "sr-only" %>
              <%= line_form.text_field :label, class: "w-full rounded border border-slate-300 px-2 py-1 text-sm" %>
            </td>
            <td class="px-2 py-2 align-top">
              <%= line_form.label :raw_text, t("receipts.edit.lines.raw_text"), class: "sr-only" %>
              <%= line_form.text_area :raw_text, rows: 2, class: "w-full rounded border border-slate-300 px-2 py-1 font-mono text-xs" %>
            </td>
            <td class="px-2 py-2 align-top">
              <%= line_form.label :quantity, t("receipts.edit.lines.quantity"), class: "sr-only" %>
              <%= line_form.number_field :quantity, step: "0.001", class: "w-full rounded border border-slate-300 px-2 py-1 text-sm" %>
            </td>
            <td class="px-2 py-2 align-top">
              <%= line_form.label :unit_of_measure, t("receipts.edit.lines.unit_of_measure"), class: "sr-only" %>
              <%= line_form.select :unit_of_measure,
                                   ReceiptLine.unit_of_measures.keys.map { |unit| [ unit_of_measure_label(unit), unit ] },
                                   {},
                                   class: "w-full rounded border border-slate-300 bg-white px-2 py-1 text-sm" %>
            </td>
            <td class="px-2 py-2 align-top">
              <%= line_form.label :unit_price_cents, t("receipts.edit.lines.unit_price_cents"), class: "sr-only" %>
              <%= line_form.number_field :unit_price_cents, class: "w-full rounded border border-slate-300 px-2 py-1 text-sm" %>
            </td>
            <td class="px-2 py-2 align-top">
              <%= line_form.label :total_cents, t("receipts.edit.lines.total_cents"), class: "sr-only" %>
              <%= line_form.number_field :total_cents, class: "w-full rounded border border-slate-300 px-2 py-1 text-sm" %>
            </td>
            <td class="px-2 py-2 align-top">
              <%= line_form.label :kind, t("receipts.edit.lines.kind"), class: "sr-only" %>
              <%= line_form.select :kind,
                                   ReceiptLine.kinds.keys.map { |kind| [ receipt_line_kind_label(kind), kind ] },
                                   {},
                                   class: "w-full rounded border border-slate-300 bg-white px-2 py-1 text-sm" %>
            </td>
            <td class="px-2 py-2 align-top text-center">
              <%= line_form.label :tr_eligible, t("receipts.edit.lines.tr_eligible"), class: "sr-only" %>
              <%= line_form.check_box :tr_eligible, class: "mt-2 h-4 w-4 rounded border-slate-300 text-slate-950" %>
            </td>
            <td class="px-2 py-2 align-top">
              <%= line_form.label :section_label, t("receipts.edit.lines.section_label"), class: "sr-only" %>
              <%= line_form.text_field :section_label, class: "w-full rounded border border-slate-300 px-2 py-1 text-sm" %>
            </td>
            <td class="px-2 py-2 align-top text-center">
              <% if line_form.object.persisted? %>
                <%= line_form.label :_destroy, class: "inline-flex items-center gap-2 text-xs text-rose-700" do %>
                  <%= line_form.check_box :_destroy, class: "h-4 w-4 rounded border-slate-300 text-rose-700" %>
                  <span><%= t("receipts.edit.lines.remove") %></span>
                <% end %>
              <% else %>
                <span class="text-xs text-slate-500"><%= t("receipts.edit.lines.new_line") %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
