<section class="hc-table-block">
  <div class="hc-block-header">
    <div class="hc-block-heading">
      <h3 class="hc-block-title"><%= t("receipts.edit.lines.heading") %></h3>
      <p class="hc-block-description"><%= t("receipts.edit.lines.add_hint") %></p>
    </div>
  </div>

  <div class="hc-table-frame">
    <table class="hc-table hc-table--dense hc-table--fixed min-w-[72rem]">
      <thead>
        <tr>
          <th class="w-12"><%= t("receipts.edit.lines.position") %></th>
          <th class="w-36"><%= t("receipts.edit.lines.label") %></th>
          <th class="w-40"><%= t("receipts.edit.lines.raw_text") %></th>
          <th class="w-20"><%= t("receipts.edit.lines.quantity") %></th>
          <th class="w-20"><%= t("receipts.edit.lines.unit_of_measure") %></th>
          <th class="w-24"><%= t("receipts.edit.lines.unit_price_cents") %></th>
          <th class="w-24"><%= t("receipts.edit.lines.total_cents") %></th>
          <th class="w-24"><%= t("receipts.edit.lines.kind") %></th>
          <th class="w-24"><%= t("receipts.edit.lines.tr_eligible") %></th>
          <th class="w-32"><%= t("receipts.edit.lines.section_label") %></th>
          <th class="w-20"><%= t("receipts.edit.lines.remove") %></th>
        </tr>
      </thead>
      <tbody>
        <%= form.fields_for :receipt_lines, receipt.receipt_lines.sort_by { |line| [ line.position || Float::INFINITY, line.id || "" ] }, include_id: false do |line_form| %>
          <tr class="<%= line_form.object.new_record? ? "hc-table-row--new" : "" %>"
              data-receipt-validators-target="line">
            <td>
              <%= line_form.hidden_field :id if line_form.object.persisted? %>
              <%= line_form.label :position, t("receipts.edit.lines.position"), class: "sr-only" %>
              <%= line_form.number_field :position, class: "hc-input hc-input--compact" %>
            </td>
            <td>
              <%= line_form.label :label, t("receipts.edit.lines.label"), class: "sr-only" %>
              <%= line_form.text_field :label,
                                       data: { receipt_validators_target: "lineLabel" },
                                       class: "hc-input hc-input--compact" %>
            </td>
            <td>
              <%= line_form.label :raw_text, t("receipts.edit.lines.raw_text"), class: "sr-only" %>
              <%= line_form.text_area :raw_text,
                                      rows: 2,
                                      data: { receipt_validators_target: "lineRawText" },
                                      class: "hc-textarea hc-textarea--compact hc-code" %>
            </td>
            <td>
              <%= line_form.label :quantity, t("receipts.edit.lines.quantity"), class: "sr-only" %>
              <%= line_form.number_field :quantity,
                                         step: "0.001",
                                         data: { receipt_validators_target: "lineQuantity" },
                                         class: "hc-input hc-input--compact" %>
            </td>
            <td>
              <%= line_form.label :unit_of_measure, t("receipts.edit.lines.unit_of_measure"), class: "sr-only" %>
              <%= line_form.select :unit_of_measure,
                                   ReceiptLine.unit_of_measures.keys.map { |unit| [ unit_of_measure_label(unit), unit ] },
                                   {},
                                   data: { receipt_validators_target: "lineUnit" },
                                   class: "hc-select hc-select--compact" %>
            </td>
            <td>
              <%= line_form.label :unit_price_cents, t("receipts.edit.lines.unit_price_cents"), class: "sr-only" %>
              <%= line_form.number_field :unit_price_cents,
                                         data: { receipt_validators_target: "lineUnitPrice" },
                                         class: "hc-input hc-input--compact" %>
            </td>
            <td>
              <%= line_form.label :total_cents, t("receipts.edit.lines.total_cents"), class: "sr-only" %>
              <%= line_form.number_field :total_cents,
                                         data: { receipt_validators_target: "lineTotal" },
                                         class: "hc-input hc-input--compact" %>
            </td>
            <td>
              <%= line_form.label :kind, t("receipts.edit.lines.kind"), class: "sr-only" %>
              <%= line_form.select :kind,
                                   ReceiptLine.kinds.keys.map { |kind| [ receipt_line_kind_label(kind), kind ] },
                                   {},
                                   data: { receipt_validators_target: "lineKind" },
                                   class: "hc-select hc-select--compact" %>
            </td>
            <td class="text-center">
              <%= line_form.label :tr_eligible, t("receipts.edit.lines.tr_eligible"), class: "sr-only" %>
              <%= line_form.check_box :tr_eligible, class: "hc-checkbox mt-2" %>
            </td>
            <td>
              <%= line_form.label :section_label, t("receipts.edit.lines.section_label"), class: "sr-only" %>
              <%= line_form.text_field :section_label,
                                       data: { receipt_validators_target: "lineSectionLabel" },
                                       class: "hc-input hc-input--compact" %>
            </td>
            <td class="text-center">
              <% if line_form.object.persisted? %>
                <%= line_form.label :_destroy, class: "hc-remove-control" do %>
                  <%= line_form.check_box :_destroy,
                                          data: { receipt_validators_target: "lineDestroy" },
                                          class: "hc-checkbox" %>
                  <span><%= t("receipts.edit.lines.remove") %></span>
                <% end %>
              <% else %>
                <span class="hc-badge hc-badge--neutral"><%= t("receipts.edit.lines.new_line") %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
