<% content_for :title, t(".title") %>

<section>
  <div class="hc-page-header flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="hc-eyebrow"><%= t(".eyebrow") %></p>
      <h1 class="hc-heading-lg mt-2"><%= t(".title") %></h1>
      <p class="hc-body mt-2 text-sm"><%= store_label(@receipt.store) %></p>
    </div>

    <%= link_to t(".back_to_index"),
                receipts_path(anchor: dom_id(@receipt)),
                class: "hc-button hc-button--secondary" %>
  </div>

  <%= turbo_frame_tag dom_id(@receipt, :review_form) do %>
    <%= render "form", receipt: @receipt, notice: @review_form_notice %>
  <% end %>
</section>
