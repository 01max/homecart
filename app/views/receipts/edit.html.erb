<% content_for :title, t(".title") %>

<section>
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium text-slate-500"><%= t(".eyebrow") %></p>
      <h1 class="mt-2 text-3xl font-semibold tracking-normal text-slate-950"><%= t(".title") %></h1>
      <p class="mt-2 text-sm text-slate-600"><%= store_label(@receipt.store) %></p>
    </div>

    <%= link_to t(".back_to_index"),
                receipts_path(anchor: dom_id(@receipt)),
                class: "inline-flex rounded border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
  </div>

  <%= turbo_frame_tag dom_id(@receipt, :review_form) do %>
    <%= render "form", receipt: @receipt, notice: @review_form_notice %>
  <% end %>
</section>
