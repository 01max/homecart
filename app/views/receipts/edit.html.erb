<% content_for :title, t(".title") %>

<section>
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium text-slate-500"><%= t(".eyebrow") %></p>
      <h1 class="mt-2 text-3xl font-semibold tracking-normal text-slate-950"><%= t(".title") %></h1>
      <p class="mt-2 text-sm text-slate-600"><%= store_label(@receipt.store) %></p>
    </div>

    <%= link_to t(".back_to_index"),
                receipts_path(anchor: dom_id(@receipt)),
                class: "inline-flex rounded border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <section class="min-w-0 rounded border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <h2 class="text-lg font-semibold text-slate-950"><%= t(".extraction.heading") %></h2>
          <p class="mt-1 text-sm text-slate-600"><%= t(".extraction.engine", engine: @receipt.text_extraction.engine) %></p>
        </div>
        <span class="rounded bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700">
          <%= @receipt.text_extraction.success? ? t(".extraction.success") : t(".extraction.failure") %>
        </span>
      </div>

      <% if @receipt.text_extraction.success? %>
        <pre class="mt-4 max-h-[42rem] overflow-auto rounded bg-slate-950 p-4 text-sm leading-6 text-slate-50"><%= @receipt.text_extraction.text %></pre>
      <% else %>
        <p class="mt-4 rounded bg-rose-50 p-4 text-sm text-rose-900"><%= @receipt.text_extraction.error_message %></p>
      <% end %>
    </section>

    <%= turbo_frame_tag dom_id(@receipt, :review_form), class: "min-w-0" do %>
      <%= render "form", receipt: @receipt %>
    <% end %>
  </div>
</section>
