<%= form_with model: receipt,
              class: "hc-stack",
              data: {
                controller: "receipt-validators",
                action: "input->receipt-validators#recompute change->receipt-validators#recompute",
                receipt_validators_pass_label_value: t("receipts.edit.validators.pass"),
                receipt_validators_fail_label_value: t("receipts.edit.validators.fail"),
                receipt_validators_skipped_label_value: t("receipts.edit.validators.skipped"),
                receipt_validators_totals_pass_detail_value: t("receipts.edit.validators.totals_sum.pass_detail"),
                receipt_validators_totals_fail_detail_template_value: t("receipts.edit.validators.totals_sum.fail_detail"),
                receipt_validators_article_pass_detail_value: t("receipts.edit.validators.article_count.pass_detail"),
                receipt_validators_article_fail_detail_template_value: t("receipts.edit.validators.article_count.fail_detail"),
                receipt_validators_article_skipped_detail_value: t("receipts.edit.validators.article_count.skipped_detail"),
                receipt_validators_payments_pass_detail_value: t("receipts.edit.validators.payments_sum.pass_detail"),
                receipt_validators_payments_fail_detail_template_value: t("receipts.edit.validators.payments_sum.fail_detail")
              } do |form| %>
  <% if receipt.errors.any? %>
    <div class="hc-flash hc-flash--alert text-sm">
      <p class="font-medium"><%= t("receipts.edit.form.errors.heading") %></p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% receipt.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <section class="hc-evidence-block min-w-0">
      <div class="hc-block-header">
        <div class="hc-block-heading">
          <h2 class="hc-block-title"><%= t("receipts.edit.extraction.heading") %></h2>
          <p class="hc-block-description"><%= t("receipts.edit.extraction.description", engine: receipt.text_extraction.engine) %></p>
        </div>
        <div class="hc-block-actions">
          <span class="hc-badge <%= receipt.text_extraction.success? ? "hc-badge--success" : "hc-badge--failed" %>">
            <%= receipt.text_extraction.success? ? t("receipts.edit.extraction.success") : t("receipts.edit.extraction.failure") %>
          </span>
        </div>
      </div>

      <% if receipt.text_extraction.success? %>
        <div class="hc-block-body">
          <pre class="hc-evidence-pane max-h-[42rem]"><%= receipt.text_extraction.text %></pre>
        </div>
      <% else %>
        <div class="hc-block-body">
          <p class="hc-flash hc-flash--alert text-sm"><%= receipt.text_extraction.error_message %></p>
        </div>
      <% end %>
    </section>

    <section class="hc-detail-block min-w-0">
      <div class="hc-block-header">
        <div class="hc-block-heading">
          <h2 class="hc-block-title"><%= t("receipts.edit.form.heading") %></h2>
          <p class="hc-block-description"><%= t("receipts.edit.form.description") %></p>
        </div>
      </div>

      <div class="hc-block-body">
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <%= form.label :store_id, t("receipts.edit.form.store"), class: "hc-label" %>
            <%= form.collection_select :store_id,
                                       @stores,
                                       :id,
                                       ->(store) { store_label(store) },
                                       {},
                                       class: "hc-select mt-1" %>
          </div>

          <div class="sm:col-span-2">
            <%= form.label :purchased_at, t("receipts.edit.form.purchased_at"), class: "hc-label" %>
            <%= form.datetime_field :purchased_at,
                                    value: receipt.purchased_at&.strftime("%Y-%m-%dT%H:%M"),
                                    class: "hc-input mt-1" %>
          </div>

          <div>
            <%= form.label :register_number, t("receipts.edit.form.register_number"), class: "hc-label" %>
            <%= form.text_field :register_number, class: "hc-input mt-1" %>
          </div>

          <div>
            <%= form.label :ticket_number, t("receipts.edit.form.ticket_number"), class: "hc-label" %>
            <%= form.text_field :ticket_number, class: "hc-input mt-1" %>
          </div>

          <div>
            <%= form.label :cashier_code, t("receipts.edit.form.cashier_code"), class: "hc-label" %>
            <%= form.text_field :cashier_code, class: "hc-input mt-1" %>
          </div>

          <div>
            <%= form.label :total_cents, t("receipts.edit.form.total_cents"), class: "hc-label" %>
            <%= form.number_field :total_cents,
                                  data: { receipt_validators_target: "receiptTotal" },
                                  class: "hc-input mt-1" %>
          </div>

          <div>
            <%= form.label :declared_article_count, t("receipts.edit.form.declared_article_count"), class: "hc-label" %>
            <%= form.number_field :declared_article_count,
                                  data: { receipt_validators_target: "declaredArticleCount" },
                                  class: "hc-input mt-1" %>
          </div>
        </div>

        <dl class="hc-divider-top hc-detail-grid mt-5 pt-5 text-sm">
          <div class="hc-detail-item">
            <dt class="hc-detail-term"><%= t("receipts.edit.form.parser_status") %></dt>
            <dd class="hc-detail-value"><%= parser_status_label(receipt.parser_status) %></dd>
          </div>
          <div class="hc-detail-item">
            <dt class="hc-detail-term"><%= t("receipts.edit.form.parser_format") %></dt>
            <dd class="hc-detail-value">
              <%= form.select :parser_format,
                              SourceDocument::PARSER_FORMATS.values,
                              { selected: receipt.parser_format_before_type_cast },
                              class: "hc-select hc-code" %>
            </dd>
          </div>
        </dl>
      </div>
    </section>
  </div>

  <%= render "receipt_lines_fields", form: form, receipt: receipt %>
  <%= render "receipt_promotions_fields", form: form, receipt: receipt %>
  <%= render "receipt_payments_fields", form: form, receipt: receipt %>
  <%= render "validators_panel" %>

  <div class="hc-action-block">
    <p class="hc-action-block-copy min-h-5 font-semibold" aria-live="polite">
      <%= local_assigns[:notice].presence || t("receipts.edit.form.action_hint") %>
    </p>
    <div class="hc-action-group">
      <%= form.submit t("receipts.edit.form.submit"),
                      data: { turbo_submits_with: t("receipts.edit.form.saving") },
                      class: "hc-button hc-button--secondary" %>
      <%= form.submit t("receipts.edit.form.mark_reviewed"),
                      formaction: mark_reviewed_receipt_path(receipt),
                      data: { turbo_submits_with: t("receipts.edit.form.marking_reviewed") },
                      class: "hc-button hc-button--primary" %>
      <%= form.submit t("receipts.edit.form.rerun_parser"),
                      formaction: rerun_parser_receipt_path(receipt),
                      data: {
                        turbo_confirm: t("receipts.edit.form.rerun_parser_confirm"),
                        turbo_submits_with: t("receipts.edit.form.rerunning_parser")
                      },
                      class: "hc-button hc-button--tertiary" %>
    </div>
  </div>
<% end %>
