<section class="rounded border border-slate-200 bg-white p-5 shadow-sm">
  <div class="mb-3 flex flex-col gap-1">
    <h3 class="text-base font-semibold text-slate-950"><%= t("receipts.edit.payments.heading") %></h3>
    <p class="text-sm text-slate-600"><%= t("receipts.edit.payments.add_hint") %></p>
  </div>

  <div class="overflow-x-auto rounded border border-slate-200">
    <table class="w-full min-w-[48rem] table-fixed border-collapse text-sm">
      <thead class="bg-slate-100 text-left text-xs font-semibold uppercase text-slate-600">
        <tr>
          <th class="w-16 px-2 py-2"><%= t("receipts.edit.payments.position") %></th>
          <th class="w-56 px-2 py-2"><%= t("receipts.edit.payments.raw_label") %></th>
          <th class="w-40 px-2 py-2"><%= t("receipts.edit.payments.category") %></th>
          <th class="w-28 px-2 py-2"><%= t("receipts.edit.payments.amount_cents") %></th>
          <th class="w-24 px-2 py-2"><%= t("receipts.edit.payments.remove") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 bg-white">
        <%= form.fields_for :receipt_payments, receipt.receipt_payments.sort_by { |payment| [ payment.position || Float::INFINITY, payment.id || "" ] }, include_id: false do |payment_form| %>
          <tr class="<%= payment_form.object.new_record? ? "bg-slate-50" : "" %>">
            <td class="px-2 py-2 align-top">
              <%= payment_form.hidden_field :id if payment_form.object.persisted? %>
              <%= payment_form.label :position, t("receipts.edit.payments.position"), class: "sr-only" %>
              <%= payment_form.number_field :position, class: "w-full rounded border border-slate-300 px-2 py-1 text-sm" %>
            </td>
            <td class="px-2 py-2 align-top">
              <%= payment_form.label :raw_label, t("receipts.edit.payments.raw_label"), class: "sr-only" %>
              <%= payment_form.text_field :raw_label, class: "w-full rounded border border-slate-300 px-2 py-1 text-sm" %>
            </td>
            <td class="px-2 py-2 align-top">
              <%= payment_form.label :category, t("receipts.edit.payments.category"), class: "sr-only" %>
              <%= payment_form.select :category,
                                      ReceiptPayment.categories.keys.map { |category| [ receipt_payment_category_label(category), category ] },
                                      {},
                                      class: "w-full rounded border border-slate-300 bg-white px-2 py-1 text-sm" %>
            </td>
            <td class="px-2 py-2 align-top">
              <%= payment_form.label :amount_cents, t("receipts.edit.payments.amount_cents"), class: "sr-only" %>
              <%= payment_form.number_field :amount_cents, class: "w-full rounded border border-slate-300 px-2 py-1 text-sm" %>
            </td>
            <td class="px-2 py-2 align-top text-center">
              <% if payment_form.object.persisted? %>
                <%= payment_form.label :_destroy, class: "inline-flex items-center gap-2 text-xs text-rose-700" do %>
                  <%= payment_form.check_box :_destroy, class: "h-4 w-4 rounded border-slate-300 text-rose-700" %>
                  <span><%= t("receipts.edit.payments.remove") %></span>
                <% end %>
              <% else %>
                <span class="text-xs text-slate-500"><%= t("receipts.edit.payments.new_payment") %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
