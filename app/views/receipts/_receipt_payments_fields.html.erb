<section class="hc-card">
  <div class="mb-3 flex flex-col gap-1">
    <h3 class="hc-heading-md"><%= t("receipts.edit.payments.heading") %></h3>
    <p class="hc-body text-sm"><%= t("receipts.edit.payments.add_hint") %></p>
  </div>

  <div class="hc-table-frame">
    <table class="hc-table hc-table--dense hc-table--fixed min-w-[48rem]">
      <thead>
        <tr>
          <th class="w-16"><%= t("receipts.edit.payments.position") %></th>
          <th class="w-56"><%= t("receipts.edit.payments.raw_label") %></th>
          <th class="w-40"><%= t("receipts.edit.payments.category") %></th>
          <th class="w-28"><%= t("receipts.edit.payments.amount_cents") %></th>
          <th class="w-24"><%= t("receipts.edit.payments.remove") %></th>
        </tr>
      </thead>
      <tbody>
        <%= form.fields_for :receipt_payments, receipt.receipt_payments.sort_by { |payment| [ payment.position || Float::INFINITY, payment.id || "" ] }, include_id: false do |payment_form| %>
          <tr class="<%= payment_form.object.new_record? ? "hc-table-row--new" : "" %>"
              data-receipt-validators-target="payment">
            <td>
              <%= payment_form.hidden_field :id if payment_form.object.persisted? %>
              <%= payment_form.label :position, t("receipts.edit.payments.position"), class: "sr-only" %>
              <%= payment_form.number_field :position, class: "hc-input hc-input--compact" %>
            </td>
            <td>
              <%= payment_form.label :raw_label, t("receipts.edit.payments.raw_label"), class: "sr-only" %>
              <%= payment_form.text_field :raw_label,
                                          data: { receipt_validators_target: "paymentRawLabel" },
                                          class: "hc-input hc-input--compact" %>
            </td>
            <td>
              <%= payment_form.label :category, t("receipts.edit.payments.category"), class: "sr-only" %>
              <%= payment_form.select :category,
                                      ReceiptPayment.categories.keys.map { |category| [ receipt_payment_category_label(category), category ] },
                                      {},
                                      class: "hc-select hc-select--compact" %>
            </td>
            <td>
              <%= payment_form.label :amount_cents, t("receipts.edit.payments.amount_cents"), class: "sr-only" %>
              <%= payment_form.number_field :amount_cents,
                                            data: { receipt_validators_target: "paymentAmount" },
                                            class: "hc-input hc-input--compact" %>
            </td>
            <td class="text-center">
              <% if payment_form.object.persisted? %>
                <%= payment_form.label :_destroy, class: "hc-remove-control" do %>
                  <%= payment_form.check_box :_destroy,
                                             data: { receipt_validators_target: "paymentDestroy" },
                                             class: "hc-checkbox" %>
                  <span><%= t("receipts.edit.payments.remove") %></span>
                <% end %>
              <% else %>
                <span class="hc-badge hc-badge--neutral"><%= t("receipts.edit.payments.new_payment") %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
