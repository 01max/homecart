<% content_for :title, t(".title") %>
<% sort_link_params = lambda do |column|
     next_direction = @sort_column == column && @sort_direction == "asc" ? "desc" : "asc"
     { label_filter: @label_filter.presence, sort: column, direction: next_direction }.compact
   end %>
<% sort_indicator = lambda do |column|
     next "" unless @sort_column == column

     @sort_direction == "asc" ? "↑" : "↓"
   end %>
<% sort_label = lambda do |column, label|
     next_direction = @sort_column == column && @sort_direction == "asc" ? "desc" : "asc"
     t(
       ".sort.label",
       column: label,
       direction: t(".sort.directions.#{next_direction}")
     )
   end %>

<section class="hc-stack">
  <%= render "catalogue/shared/page_header",
             eyebrow: t(".eyebrow"),
             title: t(".title"),
             description: t(".description"),
             actions: link_to(t(".actions.catalogue"), catalogue_root_path, class: "hc-button hc-button--secondary") %>

  <%= form_with url: matching_queue_path, method: :get, local: true, class: "hc-filter-block" do |form| %>
    <%= form.hidden_field :sort, value: @sort_column %>
    <%= form.hidden_field :direction, value: @sort_direction %>

    <div class="hc-block-heading">
      <h2 class="hc-block-title"><%= t(".filters.heading") %></h2>
      <p class="hc-block-description"><%= t(".filters.description") %></p>
    </div>

    <div class="hc-filter-row">
      <div class="hc-filter-group">
        <%= form.label :label_filter, t(".filters.label_filter"), class: "hc-label" %>
        <%= form.search_field :label_filter,
                              value: @label_filter,
                              placeholder: t(".filters.label_placeholder"),
                              class: "hc-input" %>
      </div>

      <div class="hc-filter-actions">
        <%= form.submit t(".filters.submit"), class: "hc-button hc-button--secondary" %>
        <% if @label_filter.present? %>
          <%= link_to t(".filters.clear"),
                      matching_queue_path(sort: @sort_column, direction: @sort_direction),
                      class: "hc-button hc-button--subtle" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <section class="hc-table-block">
    <div class="hc-block-header">
      <div class="hc-block-heading">
        <h2 class="hc-block-title"><%= t(".queue.heading") %></h2>
        <p class="hc-block-description">
          <% if @label_filter.present? %>
            <%= t(".queue.filtered_description", label: @label_filter) %>
          <% else %>
            <%= t(".queue.description") %>
          <% end %>
        </p>
      </div>
      <p class="hc-badge hc-badge--neutral"><%= t(".queue.count", count: @line_count) %></p>
    </div>

    <% if @groups.any? %>
      <div class="hc-table-frame">
        <table class="hc-table hc-table--dense min-w-[76rem]">
          <thead>
            <tr>
              <th>
                <%= link_to matching_queue_path(sort_link_params.call("label")),
                            class: "hc-link whitespace-nowrap",
                            aria: { label: sort_label.call("label", t(".table.label")) } do %>
                  <%= t(".table.label") %>
                  <span aria-hidden="true"><%= sort_indicator.call("label") %></span>
                <% end %>
              </th>
              <th>
                <%= link_to matching_queue_path(sort_link_params.call("line_count")),
                            class: "hc-link whitespace-nowrap",
                            aria: { label: sort_label.call("line_count", t(".table.lines")) } do %>
                  <%= t(".table.lines") %>
                  <span aria-hidden="true"><%= sort_indicator.call("line_count") %></span>
                <% end %>
              </th>
              <th><%= t(".table.stores") %></th>
              <th>
                <%= link_to matching_queue_path(sort_link_params.call("first_purchased_at")),
                            class: "hc-link whitespace-nowrap",
                            aria: { label: sort_label.call("first_purchased_at", t(".table.first_purchased_at")) } do %>
                  <%= t(".table.first_purchased_at") %>
                  <span aria-hidden="true"><%= sort_indicator.call("first_purchased_at") %></span>
                <% end %>
              </th>
              <th>
                <%= link_to matching_queue_path(sort_link_params.call("last_purchased_at")),
                            class: "hc-link whitespace-nowrap",
                            aria: { label: sort_label.call("last_purchased_at", t(".table.last_purchased_at")) } do %>
                  <%= t(".table.last_purchased_at") %>
                  <span aria-hidden="true"><%= sort_indicator.call("last_purchased_at") %></span>
                <% end %>
              </th>
              <th><%= t(".table.prices") %></th>
              <th><%= t(".table.quantities") %></th>
            </tr>
          </thead>
          <tbody>
            <% @groups.each do |group| %>
              <tr>
                <td>
                  <span class="font-semibold"><%= group.representative_label %></span>
                  <span class="mt-1 block text-xs text-[var(--hc-on-surface-variant)]"><%= group.normalized_label %></span>
                </td>
                <td class="whitespace-nowrap"><%= t(".table.line_count", count: group.line_count) %></td>
                <td><%= matching_queue_store_list(group.stores) %></td>
                <td class="whitespace-nowrap"><%= matching_queue_date_label(group.first_purchased_at) %></td>
                <td class="whitespace-nowrap"><%= matching_queue_date_label(group.last_purchased_at) %></td>
                <td><%= matching_queue_price_context(group.price_context) %></td>
                <td><%= matching_queue_quantity_context(group.price_context) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="hc-block-body">
        <p class="hc-body text-sm"><%= t(".queue.empty") %></p>
      </div>
    <% end %>

    <%= hc_pagy_nav(@pagy) %>
  </section>
</section>
