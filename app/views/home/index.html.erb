<%= turbo_stream_from "hotwire_smoke" %>

<section class="w-full max-w-3xl">
  <p class="mb-3 text-sm font-medium uppercase tracking-wide text-slate-500">Homecart</p>
  <h1 class="text-3xl font-semibold text-slate-950">Receipt ingestion starts here.</h1>

  <div class="mt-8 grid gap-4 md:grid-cols-2">
    <div class="border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-semibold text-slate-900">Turbo Stream</p>
      <%= turbo_frame_tag "hotwire_smoke_status", class: "mt-4 block rounded border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700" do %>
        Waiting for the first server-rendered update.
      <% end %>
      <%= button_to "Ping stream",
                    hotwire_ping_path,
                    class: "mt-4 inline-flex items-center justify-center bg-slate-950 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800" %>
    </div>

    <div class="border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-semibold text-slate-900">Stimulus</p>
      <p class="mt-4 rounded border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700" data-controller="hotwire-smoke">
        Waiting for Stimulus.
      </p>
    </div>
  </div>
</section>
