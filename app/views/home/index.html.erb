<%= turbo_stream_from "hotwire_smoke" %>

<section class="w-full max-w-3xl">
  <div class="hc-page-header">
    <p class="hc-eyebrow"><%= t(".eyebrow") %></p>
    <h1 class="hc-heading-lg mt-2"><%= t(".title") %></h1>
  </div>

  <div class="mt-8 grid gap-4 md:grid-cols-2">
    <div class="hc-block">
      <p class="text-sm font-semibold"><%= t(".turbo_stream") %></p>
      <%= turbo_frame_tag "hotwire_smoke_status", class: "hc-surface-muted mt-4 block p-4 text-sm" do %>
        <%= t(".waiting_for_stream") %>
      <% end %>
      <%= button_to t(".ping_stream"),
                    hotwire_ping_path,
                    class: "hc-button hc-button--primary mt-4" %>
    </div>

    <div class="hc-block">
      <p class="text-sm font-semibold"><%= t(".stimulus") %></p>
      <p class="hc-surface-muted mt-4 p-4 text-sm"
         data-controller="hotwire-smoke"
         data-hotwire-smoke-message-value="<%= t(".stimulus_connected") %>">
        <%= t(".waiting_for_stimulus") %>
      </p>
    </div>
  </div>
</section>
