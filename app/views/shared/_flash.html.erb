<% flash.each do |level, message| %>
  <% flash_classes =
       case level.to_s
       when "notice"
         "hc-flash--notice"
       when "alert"
         "hc-flash--alert"
       else
         ""
       end %>

  <div class="hc-flash <%= flash_classes %> text-sm">
    <%= message %>
  </div>
<% end %>
