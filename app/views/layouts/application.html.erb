<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app.title") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#f7fafb" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#101718" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <style>
      @font-face {
        font-family: "Hanken Grotesk";
        src: url("<%= asset_path("hanken-grotesk-latin.woff2") %>") format("woff2");
        font-display: swap;
        font-style: normal;
        font-weight: 400 700;
      }
    </style>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="hc-app-shell hc-workspace-shell hc-workspace-shell--sidebar antialiased"
        data-controller="workspace-nav theme">
    <input type="checkbox"
           id="workspace_nav_collapsed"
           class="hc-workspace-rail-toggle sr-only"
           data-workspace-nav-target="toggle"
           data-action="workspace-nav#save"
           aria-label="<%= t("app.nav.collapse") %>">

    <aside class="hc-workspace-sidebar">
      <div class="hc-workspace-sidebar-inner">
        <div class="hc-workspace-sidebar-header">
          <%= link_to root_path, class: "hc-workspace-brand" do %>
            <span class="hc-workspace-brand-mark" aria-hidden="true">hc</span>
            <span class="hc-workspace-brand-copy">
              <span class="hc-workspace-brand-name"><%= t("app.title") %></span>
              <span class="hc-workspace-brand-tagline"><%= t("app.nav.tagline") %></span>
            </span>
          <% end %>

          <label for="workspace_nav_collapsed"
                 class="hc-workspace-rail-button"
                 title="<%= t("app.nav.collapse") %>">
            <span aria-hidden="true">&#x25C0;</span>
            <span class="sr-only"><%= t("app.nav.collapse") %></span>
          </label>
        </div>

        <nav class="hc-workspace-nav" aria-label="<%= t("app.nav.menu") %>">
          <%= workspace_nav_link t("app.nav.dashboard"), root_path, icon: "D", active: controller_name == "home" %>
          <%= workspace_nav_link t("app.nav.receipts"), receipts_path, icon: "R", active: controller_name == "receipts" %>
          <%= workspace_nav_link t("app.nav.catalogue"), catalogue_root_path, icon: "C", active: controller_path.start_with?("catalogue/") %>
          <%= workspace_nav_link t("app.nav.matching"), matching_root_path, icon: "M", active: controller_path.start_with?("matching/") %>
        </nav>

        <div class="hc-workspace-sidebar-footer">
          <label class="hc-theme-toggle">
            <input type="checkbox"
                   class="hc-theme-toggle-input sr-only"
                   data-theme-target="toggle"
                   data-action="theme#save"
                   aria-label="<%= t("app.nav.dark_mode") %>">
            <span class="hc-theme-toggle-control" aria-hidden="true"></span>
            <span class="hc-theme-toggle-label"><%= t("app.nav.dark_mode") %></span>
          </label>

          <%= link_to t("app.nav.upload_receipt"),
                      new_source_document_path,
                      class: "hc-button hc-button--primary" %>
        </div>
      </div>
    </aside>

    <div class="hc-workspace-main">
      <details class="lg:hidden">
        <summary class="hc-mobile-shell-bar list-none cursor-pointer">
          <span class="hc-workspace-brand">
            <span class="hc-workspace-brand-mark" aria-hidden="true">hc</span>
            <span class="hc-workspace-brand-copy">
              <span class="hc-workspace-brand-name"><%= t("app.title") %></span>
              <span class="hc-workspace-brand-tagline"><%= t("app.nav.tagline") %></span>
            </span>
          </span>
          <span class="hc-button hc-button--secondary"><%= t("app.nav.menu") %></span>
        </summary>

        <nav class="hc-mobile-nav-panel" aria-label="<%= t("app.nav.menu") %>">
          <%= workspace_nav_link t("app.nav.dashboard"), root_path, icon: "D", active: controller_name == "home" %>
          <%= workspace_nav_link t("app.nav.receipts"), receipts_path, icon: "R", active: controller_name == "receipts" %>
          <%= workspace_nav_link t("app.nav.catalogue"), catalogue_root_path, icon: "C", active: controller_path.start_with?("catalogue/") %>
          <%= workspace_nav_link t("app.nav.matching"), matching_root_path, icon: "M", active: controller_path.start_with?("matching/") %>
          <label class="hc-theme-toggle">
            <input type="checkbox"
                   class="hc-theme-toggle-input sr-only"
                   data-theme-target="toggle"
                   data-action="theme#save"
                   aria-label="<%= t("app.nav.dark_mode") %>">
            <span class="hc-theme-toggle-control" aria-hidden="true"></span>
            <span class="hc-theme-toggle-label"><%= t("app.nav.dark_mode") %></span>
          </label>
          <%= link_to t("app.nav.upload_receipt"),
                      new_source_document_path,
                      class: "hc-button hc-button--primary" %>
        </nav>
      </details>

      <main class="hc-workspace-main-inner <%= "hc-workspace-main-inner--wide" if content_for?(:wide_workspace) %>">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
