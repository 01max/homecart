<div class="hc-page-toolbar">
  <div>
    <p class="hc-eyebrow"><%= eyebrow %></p>
    <h1 class="hc-heading-lg mt-2"><%= title %></h1>
    <% if local_assigns[:description].present? %>
      <p class="hc-body mt-2"><%= description %></p>
    <% end %>
  </div>

  <% if local_assigns[:actions].present? %>
    <div class="hc-page-actions">
      <%= actions %>
    </div>
  <% end %>
</div>
