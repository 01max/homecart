<% content_for :title, t("product_catalog.manufacturers.index.title") %>

<section class="hc-stack">
  <%= render "catalogue/shared/page_header",
             eyebrow: t("product_catalog.manufacturers.index.eyebrow"),
             title: t("product_catalog.manufacturers.index.title"),
             description: t("product_catalog.manufacturers.index.description"),
             actions: safe_join([
               link_to(t("product_catalog.actions.back_to_catalogue"), catalogue_root_path, class: "hc-button hc-button--subtle"),
               link_to(t("product_catalog.manufacturers.index.actions.new"), new_catalogue_manufacturer_path, class: "hc-button hc-button--primary")
             ]) %>

  <section class="hc-table-block">
    <div class="hc-block-header">
      <div class="hc-block-heading">
        <h2 class="hc-block-title"><%= t("product_catalog.manufacturers.index.table.heading") %></h2>
        <p class="hc-block-description"><%= t("product_catalog.manufacturers.index.table.description") %></p>
      </div>
      <p class="hc-badge hc-badge--neutral"><%= t("product_catalog.counts.manufacturers", count: @manufacturers.size) %></p>
    </div>

    <% if @manufacturers.any? %>
      <div class="hc-table-frame">
        <table class="hc-table hc-table--dense min-w-[36rem]">
          <thead>
            <tr>
              <th><%= t("product_catalog.manufacturers.index.table.name") %></th>
              <th><%= t("product_catalog.manufacturers.index.table.products") %></th>
              <th><%= t("product_catalog.manufacturers.index.table.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @manufacturers.each do |manufacturer| %>
              <tr>
                <td><%= link_to manufacturer.name, catalogue_manufacturer_path(manufacturer), class: "hc-link" %></td>
                <td><%= manufacturer.products.size %></td>
                <td>
                  <div class="hc-table-cell-actions">
                    <%= link_to t("product_catalog.actions.edit"), edit_catalogue_manufacturer_path(manufacturer), class: "hc-link text-sm" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="hc-block-body">
        <p class="hc-body text-sm"><%= t("product_catalog.manufacturers.index.empty") %></p>
      </div>
    <% end %>
  </section>
</section>
