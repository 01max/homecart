<% content_for :title, t("product_catalog.products.edit.title", name: @product.name) %>

<section class="hc-stack">
  <%= render "catalogue/shared/page_header",
             eyebrow: t("product_catalog.products.edit.eyebrow"),
             title: t("product_catalog.products.edit.title", name: @product.name),
             description: t("product_catalog.products.edit.description"),
             actions: link_to(t("product_catalog.actions.back_to_detail"), catalogue_product_path(@product), class: "hc-button hc-button--subtle") %>

  <%= render "form",
             product: @product,
             title: t("product_catalog.products.edit.form_heading"),
             description: t("product_catalog.products.edit.form_description"),
             submit_label: t("product_catalog.products.form.update") %>
</section>
