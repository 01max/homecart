<% content_for :title, t("product_catalog.products.new.title") %>

<section class="hc-stack">
  <%= render "catalogue/shared/page_header",
             eyebrow: t("product_catalog.products.new.eyebrow"),
             title: t("product_catalog.products.new.title"),
             description: t("product_catalog.products.new.description"),
             actions: link_to(t("product_catalog.actions.back_to_index"), catalogue_products_path, class: "hc-button hc-button--subtle") %>

  <%= render "form",
             product: @product,
             title: t("product_catalog.products.new.form_heading"),
             description: t("product_catalog.products.new.form_description"),
             submit_label: t("product_catalog.products.form.create") %>
</section>
