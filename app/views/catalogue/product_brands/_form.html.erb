<%= form_with model: [ :catalogue, product_brand ], class: "hc-block" do |form| %>
  <div class="hc-block-heading">
    <h2 class="hc-block-title"><%= title %></h2>
    <p class="hc-block-description"><%= description %></p>
  </div>

  <div class="hc-filter-row mt-4">
    <div class="hc-filter-group">
      <%= form.label :name, t("product_catalog.product_brands.form.name"), class: "hc-label" %>
      <%= form.text_field :name, class: "hc-input", required: true %>
    </div>

    <div class="hc-filter-group">
      <%= form.label :retail_brand_id, t("product_catalog.product_brands.form.retail_brand"), class: "hc-label" %>
      <%= form.collection_select :retail_brand_id,
                                 @retail_brands,
                                 :id,
                                 :name,
                                 { include_blank: t("product_catalog.product_brands.form.no_retail_brand") },
                                 class: "hc-select" %>
    </div>

    <div class="hc-filter-actions">
      <%= form.submit submit_label, class: "hc-button hc-button--primary" %>
    </div>
  </div>
<% end %>
