<% content_for :title, t("product_catalog.product_brands.edit.title", name: @product_brand.name) %>

<section class="hc-stack">
  <%= render "catalogue/shared/page_header",
             eyebrow: t("product_catalog.product_brands.edit.eyebrow"),
             title: t("product_catalog.product_brands.edit.title", name: @product_brand.name),
             description: t("product_catalog.product_brands.edit.description"),
             actions: link_to(t("product_catalog.actions.back_to_detail"), catalogue_product_brand_path(@product_brand), class: "hc-button hc-button--subtle") %>

  <%= render "form",
             product_brand: @product_brand,
             title: t("product_catalog.product_brands.edit.form_heading"),
             description: t("product_catalog.product_brands.edit.form_description"),
             submit_label: t("product_catalog.product_brands.form.update") %>
</section>
