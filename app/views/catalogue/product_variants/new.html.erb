<% content_for :title, t("product_catalog.product_variants.new.title") %>

<section class="hc-stack">
  <%= render "catalogue/shared/page_header",
             eyebrow: t("product_catalog.product_variants.new.eyebrow"),
             title: t("product_catalog.product_variants.new.title"),
             description: t("product_catalog.product_variants.new.description"),
             actions: link_to(t("product_catalog.actions.back_to_index"), catalogue_product_variants_path, class: "hc-button hc-button--subtle") %>

  <%= render "form",
             product_variant: @product_variant,
             title: t("product_catalog.product_variants.new.form_heading"),
             description: t("product_catalog.product_variants.new.form_description"),
             submit_label: t("product_catalog.product_variants.form.create") %>
</section>
