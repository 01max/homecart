<% content_for :title, t("product_catalog.product_variants.edit.title", name: @product_variant.name) %>

<section class="hc-stack">
  <%= render "catalogue/shared/page_header",
             eyebrow: t("product_catalog.product_variants.edit.eyebrow"),
             title: t("product_catalog.product_variants.edit.title", name: @product_variant.name),
             description: t("product_catalog.product_variants.edit.description"),
             actions: link_to(t("product_catalog.actions.back_to_detail"), catalogue_product_variant_path(@product_variant), class: "hc-button hc-button--subtle") %>

  <%= render "form",
             product_variant: @product_variant,
             title: t("product_catalog.product_variants.edit.form_heading"),
             description: t("product_catalog.product_variants.edit.form_description"),
             submit_label: t("product_catalog.product_variants.form.update") %>
</section>
