<%= form_with scope: :inline_product_variant,
              url: inline_product_catalogue_product_variants_path,
              class: "hc-block" do |form| %>
  <div class="hc-block-heading">
    <h2 class="hc-block-title"><%= t("product_catalog.product_variants.inline_product.form_heading") %></h2>
    <p class="hc-block-description"><%= t("product_catalog.product_variants.inline_product.form_description") %></p>
  </div>

  <div class="hc-filter-row mt-4">
    <div class="hc-filter-group">
      <%= form.label :product_brand_name, t("product_catalog.product_variants.inline_product.product_brand_name"), class: "hc-label" %>
      <%= form.text_field :product_brand_name, class: "hc-input", required: true %>
    </div>

    <div class="hc-filter-group">
      <%= form.label :product_name, t("product_catalog.product_variants.inline_product.product_name"), class: "hc-label" %>
      <%= form.text_field :product_name, class: "hc-input", required: true %>
    </div>

    <%= render "catalogue/shared/category_picker",
               form: form,
               field: :category_id,
               categories: @categories,
               label: t("product_catalog.product_variants.inline_product.category"),
               include_blank: t("product_catalog.product_variants.inline_product.select_category"),
               required: true,
               describedby: "inline_variant_category_picker_hint",
               description: t("product_catalog.category_picker.inline_variant_description"),
               manage_label: t("product_catalog.category_picker.manage_categories") %>

    <div class="hc-filter-group">
      <%= form.label :manufacturer_name, t("product_catalog.product_variants.inline_product.manufacturer_name"), class: "hc-label" %>
      <%= form.text_field :manufacturer_name, class: "hc-input" %>
    </div>

    <div class="hc-filter-group">
      <%= form.label :variant_name, t("product_catalog.product_variants.inline_product.variant_name"), class: "hc-label" %>
      <%= form.text_field :variant_name, class: "hc-input", required: true %>
    </div>

    <div class="hc-filter-group">
      <%= form.label :package_count, t("product_catalog.product_variants.form.package_count"), class: "hc-label" %>
      <%= form.number_field :package_count, class: "hc-input", min: 1 %>
    </div>

    <div class="hc-filter-group">
      <%= form.label :quantity_value, t("product_catalog.product_variants.form.quantity_value"), class: "hc-label" %>
      <%= form.number_field :quantity_value, class: "hc-input", min: 0, step: "0.001" %>
    </div>

    <div class="hc-filter-group">
      <%= form.label :comparison_unit_id, t("product_catalog.product_variants.form.comparison_unit"), class: "hc-label" %>
      <%= form.collection_select :comparison_unit_id,
                                 @comparison_units,
                                 :id,
                                 :name,
                                 { include_blank: t("product_catalog.product_variants.form.no_comparison_unit") },
                                 class: "hc-select" %>
    </div>

    <div class="hc-filter-group">
      <%= form.label :barcode, t("product_catalog.product_variants.form.barcode"), class: "hc-label" %>
      <%= form.text_field :barcode, class: "hc-input" %>
    </div>

    <div class="hc-filter-actions">
      <%= form.submit t("product_catalog.product_variants.inline_product.create"), class: "hc-button hc-button--primary" %>
    </div>
  </div>
<% end %>
