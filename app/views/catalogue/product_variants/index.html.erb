<% content_for :title, t("product_catalog.product_variants.index.title") %>

<section class="hc-stack">
  <%= render "catalogue/shared/page_header",
             eyebrow: t("product_catalog.product_variants.index.eyebrow"),
             title: t("product_catalog.product_variants.index.title"),
             description: t("product_catalog.product_variants.index.description"),
             actions: safe_join([
               link_to(t("product_catalog.actions.back_to_catalogue"), catalogue_root_path, class: "hc-button hc-button--subtle"),
               link_to(t("product_catalog.product_variants.index.actions.new"), new_catalogue_product_variant_path, class: "hc-button hc-button--primary")
             ]) %>

  <section class="hc-table-block">
    <div class="hc-block-header">
      <div class="hc-block-heading">
        <h2 class="hc-block-title"><%= t("product_catalog.product_variants.index.table.heading") %></h2>
        <p class="hc-block-description"><%= t("product_catalog.product_variants.index.table.description") %></p>
      </div>
      <p class="hc-badge hc-badge--neutral"><%= t("product_catalog.counts.product_variants", count: @product_variants.size) %></p>
    </div>

    <% if @product_variants.any? %>
      <div class="hc-table-frame">
        <table class="hc-table hc-table--dense min-w-[64rem]">
          <thead>
            <tr>
              <th><%= t("product_catalog.product_variants.index.table.variant") %></th>
              <th><%= t("product_catalog.product_variants.index.table.product") %></th>
              <th><%= t("product_catalog.product_variants.index.table.category") %></th>
              <th><%= t("product_catalog.product_variants.index.table.quantity") %></th>
              <th><%= t("product_catalog.product_variants.index.table.barcode") %></th>
              <th><%= t("product_catalog.product_variants.index.table.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @product_variants.each do |product_variant| %>
              <tr>
                <td><%= link_to product_variant.name, catalogue_product_variant_path(product_variant), class: "hc-link" %></td>
                <td><%= catalogue_product_label(product_variant.product) %></td>
                <td><%= catalogue_category_label(product_variant.product.category) %></td>
                <td><%= t("product_catalog.labels.variant_quantity", package_count: product_variant.package_count || t("product_catalog.labels.empty_value"), quantity_value: product_variant.quantity_value || t("product_catalog.labels.empty_value"), unit: product_variant.comparison_unit&.symbol || t("product_catalog.labels.empty_value")) %></td>
                <td><%= product_variant.barcode.presence || t("product_catalog.labels.empty_value") %></td>
                <td>
                  <div class="hc-table-cell-actions">
                    <%= link_to t("product_catalog.actions.edit"), edit_catalogue_product_variant_path(product_variant), class: "hc-link text-sm" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="hc-block-body">
        <p class="hc-body text-sm"><%= t("product_catalog.product_variants.index.empty") %></p>
      </div>
    <% end %>
  </section>
</section>
